  "text": [
    {
      "id": "t1",
      "target": "Hallo! Guten Tag! Ich heiße Alex. Wie heißt du?",
      "ru": "Привет! Добрый день! Меня зовут Алекс. Как тебя зовут?",
      "audio": "audio/de/a1/unit_01/t1.mp3"
    },
    {
      "id": "t2",
      "target": "Guten Tag, Alex! Ich heiße Sarah. Freut mich, dich kennenzulernen!",
      "ru": "Добрый день, Алекс! Меня зовут Сара. Очень приятно познакомиться!",
      "audio": "audio/de/a1/unit_01/t2.mp3"
    },
    {
      "id": "t3",
      "target": "Woher kommst du, Sarah, und wo wohnst du jetzt?",
      "ru": "Откуда ты родом, Сара, и где ты сейчас живёшь?",
      "audio": "audio/de/a1/unit_01/t3.mp3"
    },
    {
      "id": "t4",
      "target": "Ich komme aus Deutschland, aber jetzt wohne ich in Wien. Und du?",
      "ru": "Я родом из Германии, но сейчас я живу в Вене. А ты?",
      "audio": "audio/de/a1/unit_01/t4.mp3"
    },
    {
      "id": "t5",
      "target": "Ich komme aus Österreich und ich wohne auch in Wien.",
      "ru": "Я родом из Австрии и я тоже живу в Вене.",
      "audio": "audio/de/a1/unit_01/t5.mp3"
    },
    {
      "id": "t6",
      "target": "Was bist du von Beruf? Arbeitest du hier?",
      "ru": "Кто ты по профессии? Ты работаешь здесь?",
      "audio": "audio/de/a1/unit_01/t6.mp3"
    },
    {
      "id": "t7",
      "target": "Ich bin Programmierer von Beruf. Ich lerne jetzt fleißig Deutsch.",
      "ru": "Я программист по профессии. Сейчас я усердно учу немецкий язык.",
      "audio": "audio/de/a1/unit_01/t7.mp3"
    },
    {
      "id": "t8",
      "target": "Super! Du sprichst schon gut Deutsch. Das Lernen macht Spaß!",
      "ru": "Супер! Ты уже хорошо говоришь по-немецки. Учёба доставляет удовольствие!",
      "audio": "audio/de/a1/unit_01/t8.mp3"
    }
  ],
